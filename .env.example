# ==============================================================================
# DigiVigee Platform — Environment Variables Template
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Google Analytics (GA4) & Google Tag Manager (GTM) Setup
# Paste your ID below whenever ready to activate tracking automatically.
# Leave empty or commented out if not in use (0% impact on website speed).
# ------------------------------------------------------------------------------
# Agar Google Analytics use karna ho:
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Ya agar Google Tag Manager use karna ho:
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Publicly accessible in browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-Side ONLY)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
